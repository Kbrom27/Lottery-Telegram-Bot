# ---- Telegram ----
BOT_TOKEN=123456:replace-with-token-from-BotFather
# Comma-separated numeric Telegram user IDs allowed to use /pending /stats /export /find and the review buttons
ADMIN_IDS=111111111

# ---- Database ----
DATABASE_URL=postgresql+asyncpg://lottery:lottery@db:5432/lottery
POSTGRES_PASSWORD=lottery

# ---- Campaign rules ----
CAMPAIGN_NAME=Abel Online Lottery
TICKET_PRICE=100
MAX_TICKETS_PER_PAYMENT=20
FIRST_TICKET_NUMBER=1
TICKET_WIDTH=5
# ISO 8601. No timezone => Ethiopia time (UTC+3)
CAMPAIGN_START=2026-12-01T00:00:00
CAMPAIGN_END=2026-12-31T23:59:59
# Shown on /start. Use \n for new lines.
PAYMENT_INSTRUCTIONS=Pay 100 ETB per ticket to:\nTelebirr: 09XXXXXXXX (Account Name)\nCBE: 1000XXXXXXXXX (Account Name)

# ---- Verification ----
# Shared secret for the SMS-forwarder -> POST /sms  (generate: python -c "import secrets; print(secrets.token_urlsafe(32))")
SMS_SECRET=change-me
# How long to wait for the bank SMS to arrive before sending a payment to manual review
CREDIT_WAIT_MINUTES=20
RETRY_INTERVAL_SECONDS=60
MAX_OPEN_PAYMENTS_PER_USER=3

# ---- Screenshot reading ----
# tesseract = free, runs locally.  claude = vision model, more tolerant of layouts (needs ANTHROPIC_API_KEY)
EXTRACTOR=tesseract
OCR_LANGS=eng
# ANTHROPIC_API_KEY=
# CLAUDE_MODEL=claude-sonnet-5-5

# ---- Telegram transport ----
# Leave empty for long polling (simplest). For webhooks set both (HTTPS URL + a random [A-Za-z0-9_-] secret).
WEBHOOK_BASE_URL=
WEBHOOK_SECRET=

STORAGE_DIR=/srv/data/screenshots
